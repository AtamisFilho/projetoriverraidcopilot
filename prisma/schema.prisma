generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Score {
  id        Int      @id @default(autoincrement())
  name      String
  score     Int
  distance  Int
  chapter   Int      @default(1)
  enemies   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([score])
}
